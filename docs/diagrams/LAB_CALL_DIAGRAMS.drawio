          <mxGeometry x="20" y="50" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="o2" value="MockLLMAdapter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="outg">
          <mxGeometry x="20" y="115" width="240" height="50" as="geometry" />
