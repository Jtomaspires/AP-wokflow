        <mxCell id="n0d" value="Sender&#xa;accepted?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="385" y="480" width="170" height="90" as="geometry" />
