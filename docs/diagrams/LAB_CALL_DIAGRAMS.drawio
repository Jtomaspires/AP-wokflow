        </mxCell>
        <mxCell id="n1" value="1 · Ingest&#xa;EmailPort + save Ticket OPEN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
