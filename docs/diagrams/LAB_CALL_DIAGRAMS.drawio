          <mxGeometry x="40" y="80" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="o_sec" value="security" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="o_thr" value="thread" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="40" y="280" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="o_tri" value="triage, intent, sender" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="40" y="380" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="o_rou" value="routing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="40" y="480" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="o_res" value="resolution&#xa;SAP lookup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="40" y="580" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="o_dra" value="draft&#xa;pick_target" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="40" y="680" width="160" height="60" as="geometry" />
