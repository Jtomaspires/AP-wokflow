        <mxCell id="r2" edge="1" parent="1" source="api" target="redis" style="endArrow=block;endFill=1;" value=".delay">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r3" edge="1" parent="1" source="redis" target="w" style="endArrow=block;endFill=1;" value="task">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r4" edge="1" parent="1" source="w" target="g" style="endArrow=block;endFill=1;" value="invoke">
          <mxGeometry relative="1" as="geometry" />
