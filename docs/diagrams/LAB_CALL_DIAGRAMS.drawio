        </mxCell>
        <mxCell id="p3" value="LLMPort" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="ports">
          <mxGeometry x="20" y="110" width="200" height="44" as="geometry" />
        </mxCell>
        <mxCell id="pnote" value="Triage does not import openai.&#xa;Ingest does not import SQLModel." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#555555;" vertex="1" parent="ports">
          <mxGeometry x="20" y="170" width="420" height="40" as="geometry" />
