  <diagram id="runtime" name="3. Request queue worker DB">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t3" value="Mini-lab — runtime path (the piece to feel by hand)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontStyle=1;fontSize=20;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="800" height="30" as="geometry" />
        </mxCell>
        <mxCell id="t3s" value="FastAPI only enqueues. LangGraph runs inside the Celery worker. GET reads Postgres." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="800" height="24" as="geometry" />
