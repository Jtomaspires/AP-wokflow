        </mxCell>
        <mxCell id="pg" value="Postgres&#xa;tickets (Alembic)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1040" y="175" width="140" height="110" as="geometry" />
        </mxCell>
        <mxCell id="get" value="GET /tickets/{id}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;" vertex="1" parent="1">
