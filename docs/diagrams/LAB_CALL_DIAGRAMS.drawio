          <mxGeometry x="300" y="190" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="redis" value="Redis&#xa;Celery broker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="510" y="190" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="worker" value="Celery worker&#xa;process_email&#xa;pool solo on Windows" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="720" y="175" width="180" height="100" as="geometry" />
        </mxCell>
        <mxCell id="graph" value="LangGraph&#xa;ainvoke&#xa;stops at hitl" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="960" y="175" width="160" height="100" as="geometry" />
        </mxCell>
        <mxCell id="pg" value="Postgres&#xa;tickets, drafts, audit" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1180" y="165" width="160" height="120" as="geometry" />
        </mxCell>
        <mxCell id="ack" value="mock and ingest: 202 task_id&#xa;POST /webhook/nylas: 200&#xa;returned before the graph runs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="320" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="fallback" value="If Redis is down, FastAPI runs the graph in-process and returns ticket_id and status." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="450" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="qe1" edge="1" parent="1" source="src" target="api" style="endArrow=block;endFill=1;" />
        <mxCell id="qe2" edge="1" parent="1" source="api" target="redis" style="endArrow=block;endFill=1;" value=".delay" />
        <mxCell id="qe3" edge="1" parent="1" source="redis" target="worker" style="endArrow=block;endFill=1;" />
        <mxCell id="qe4" edge="1" parent="1" source="worker" target="graph" style="endArrow=block;endFill=1;" value="ainvoke" />
