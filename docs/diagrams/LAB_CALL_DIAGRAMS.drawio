<mxfile host="app.diagrams.net" agent="p2p-ai-langraph mini-lab" version="22.1.0">
  <diagram id="hex" name="1. Hexagonal architecture">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t1" value="Mini-lab — hexagonal architecture" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontStyle=1;fontSize=20;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="560" height="30" as="geometry" />
        </mxCell>
        <mxCell id="t1s" value="Core never imports Postgres, Redis, or OpenAI. Three ports only. Adapters swap (memory tests / Postgres worker)." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="900" height="24" as="geometry" />
        </mxCell>
        <mxCell id="drv" value="Driving adapters — inbound" style="swimlane;fontStyle=1;align=center;startSize=32;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="260" height="220" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="curl / TestClient" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="drv">
          <mxGeometry x="20" y="50" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="FastAPI&#xa;POST /ingest · GET /tickets/{id}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="drv">
          <mxGeometry x="20" y="120" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="hexg" value="Core — vendor-agnostic" style="swimlane;fontStyle=1;align=center;startSize=32;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="90" width="520" height="520" as="geometry" />
        </mxCell>
        <mxCell id="dom" value="Domain&#xa;IncomingEmail · Ticket · TicketStatus&#xa;WorkflowDeps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="hexg">
          <mxGeometry x="30" y="50" width="460" height="80" as="geometry" />
        </mxCell>
        <mxCell id="uc1" value="LangGraph&#xa;ingest → security → triage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="hexg">
          <mxGeometry x="30" y="150" width="460" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ports" value="Ports — contracts" style="swimlane;fontStyle=1;startSize=28;fillColor=#e1d5e7;strokeColor=#9673a6;rounded=1;" vertex="1" parent="hexg">
          <mxGeometry x="30" y="240" width="460" height="240" as="geometry" />
        </mxCell>
        <mxCell id="p1" value="EmailPort" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="ports">
          <mxGeometry x="20" y="50" width="200" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="TicketStorePort" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="ports">
