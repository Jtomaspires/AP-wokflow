        <mxCell id="x_ing" value="Missing thread_id or message_id: no ticket, no audit row.&#xa;Same message_id, or same sender plus subject plus first 300 chars: old ticket unchanged." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
