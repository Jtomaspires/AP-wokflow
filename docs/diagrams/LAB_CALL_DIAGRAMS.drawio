  <diagram id="architecture" name="2. Architecture">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="at" value="Seven ports. The graph does not import Postgres, Redis, or an LLM vendor. Nylas send is not a port." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontStyle=1;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1100" height="30" as="geometry" />
        </mxCell>
        <mxCell id="drv" value="Driving" style="swimlane;fontStyle=1;align=center;startSize=32;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="280" height="520" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="React console&#xa;http://localhost:5173&#xa;cookie session" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="drv">
          <mxGeometry x="20" y="50" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="poll_nylas.py&#xa;or POST /webhook/nylas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="drv">
          <mxGeometry x="20" y="150" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="FastAPI&#xa;/webhook/mock · /tickets&#xa;approve · escalate · /auth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="drv">
          <mxGeometry x="20" y="240" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="d4" value="Auth is not a workflow port.&#xa;The graph never sees the operator." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;" vertex="1" parent="drv">
          <mxGeometry x="20" y="350" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="hex" value="Core" style="swimlane;fontStyle=1;align=center;startSize=32;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="70" width="560" height="620" as="geometry" />
        </mxCell>
        <mxCell id="dom" value="Ticket · Invoice · Draft · Sender · Audit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="hex">
          <mxGeometry x="20" y="50" width="520" height="50" as="geometry" />
        </mxCell>
        <mxCell id="spine" value="ingest → security → thread → triage → intent → sender → routing → resolution → draft → hitl&#xa;Graph ends at hitl. Approve calls send outside the graph." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="hex">
          <mxGeometry x="20" y="120" width="520" height="70" as="geometry" />
