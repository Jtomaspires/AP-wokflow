        <mxCell id="src" value="poll_nylas.py&#xa;POST /webhook/mock&#xa;POST /webhook/nylas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="200" height="90" as="geometry" />
        </mxCell>
