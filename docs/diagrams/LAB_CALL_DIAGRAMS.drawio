        <mxCell id="wt" value="Inbound workflow. The graph ends at hitl. Approve runs send in the API, not in Celery." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontStyle=1;fontSize=16;" vertex="1" parent="1">
